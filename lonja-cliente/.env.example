# Copia este archivo como .env (el .env NO se sube a GitHub)

# Puerto del cliente (las pantallas del sistema)
PORT_CLIENTE=3000

# Dirección de la Lonja API (proyecto lonja-api). Debe estar encendida.
API_URL=http://localhost:2900/api

# Orígenes extra que pueden enviar formularios, separados por comas (opcional).
# Ej: http://192.168.1.50:3000
CORS_ORIGENES=
