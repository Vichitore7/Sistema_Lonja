# Copia este archivo como .env y pon tus datos (el .env NO se sube a GitHub)

# Base de datos MariaDB
BD_NOMBRE=lonja_veracruz_2026
BD_USUARIO=tu_usuario
BD_CLAVE=tu_clave
BD_DIALEC=mariadb
BD_HOST=127.0.0.1
BD_PORT=3306

# Servidor
URL_BACKEND=http://localhost
PORT_BACKEND=2800

# Sesión (JWT en cookie HttpOnly _token)
SC_JWT=cambia_esta_firma_larga_y_aleatoria
JWT_EXPIRA=8h

# Administrador inicial: solo lo usa "npm run instalar" para crearlo una vez
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_clave
