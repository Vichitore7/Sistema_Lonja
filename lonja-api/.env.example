# Copia este archivo como .env y pon tus datos (el .env NO se sube a GitHub)

# Base de datos MariaDB
BD_NOMBRE=lonja_veracruz_2026
BD_USUARIO=tu_usuario
BD_CLAVE=tu_clave
BD_DIALEC=mariadb
BD_HOST=127.0.0.1
BD_PORT=3306

# Puerto de la API
PORT_API=2900

# Dirección del proyecto lonja-cliente: se usa para el enlace del correo de confirmación y en CORS
URL_CLIENTE=http://localhost:3000

# Firma de los JSON Web Token (el cliente los manda en Authorization: Bearer <token>)
SC_JWT=cambia_esta_firma_larga_y_aleatoria
JWT_EXPIRA=8h

# Administrador inicial: solo lo usa "npm run instalar" para crearlo una vez
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_clave

# Correo para confirmar las cuentas de comprador (SMTP). Ejemplo con Gmail:
# activa la verificación en 2 pasos y crea una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords ; úsala en EMAIL_PASS.
# Si EMAIL_HOST se deja vacío, el enlace de confirmación se muestra en la consola de la API.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM="Lonja Veracruz <tu_correo@gmail.com>"

# CORS: URL_CLIENTE siempre está permitido. Orígenes extra separados por comas (opcional)
CORS_ORIGENES=
