<%- include('../partials/head') %>
<%- include('../partials/inicioLayout') %>

<%- include('../partials/encabezado', { titulo: 'Compradores', migas: [{ texto: 'Compradores', url: '/compradores' }, { texto: 'Listado' }] }) %>
<%- include('../partials/alerts') %>

<section class="tarjeta">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div class="tarjeta-titulo">
            <i class="icon-users" aria-hidden="true"></i>
            <div><h2>Compradores</h2><p>Consulta, registra y administra los compradores del sistema.</p></div>
        </div>
        <a href="/compradores/nuevo" class="btn btn-turquesa"><i class="icon-user-plus" aria-hidden="true"></i>Nuevo comprador</a>
    </div>

    <form class="row g-2 align-items-end mb-3" method="GET" action="/compradores" role="search">
        <div class="col-12 col-md-5">
            <label class="form-label" for="codigo">Código del comprador</label>
            <div class="input-group">
                <span class="input-group-text"><i class="icon-hash" aria-hidden="true"></i></span>
                <input type="text" inputmode="numeric" pattern="[0-9]*" id="codigo" name="codigo" class="form-control" placeholder="Ej. 001" value="<%= codigo %>" maxlength="9">
            </div>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-turquesa"><i class="icon-search" aria-hidden="true"></i>Buscar</button></div>
        <% if (codigo) { %><div class="col-auto"><a href="/compradores" class="btn btn-blanco"><i class="icon-refresh-cw" aria-hidden="true"></i>Ver todos</a></div><% } %>
    </form>

    <div class="tabla-contenedor">
        <table class="tabla">
            <thead><tr><th>Código</th><th>Nombre completo</th><th>Correo</th><th>Dirección</th><th class="text-center">Acciones</th></tr></thead>
            <tbody>
            <% if (!compradores.length) { %><tr class="vacio"><td colspan="5"><%= codigo ? 'No existe un comprador con ese código.' : 'Todavía no hay compradores registrados.' %></td></tr><% } %>
            <% compradores.forEach((c) => { %>
                <tr>
                    <td><strong><%= f.folio(c.codigo_cpr) %></strong></td>
                    <td><%= f.nombreCompleto(c) %></td>
                    <td><%= c.correo || '—' %></td>
                    <td><%= c.direccion %></td>
                    <td>
                        <div class="acciones">
                            <a href="/compradores/<%= c.codigo_cpr %>" class="btn-icono" title="Ver" aria-label="Ver comprador <%= f.folio(c.codigo_cpr) %>"><i class="icon-eye" aria-hidden="true"></i></a>
                            <a href="/compradores/<%= c.codigo_cpr %>/editar" class="btn-icono" title="Editar" aria-label="Editar comprador <%= f.folio(c.codigo_cpr) %>"><i class="icon-pencil" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('../partials/paginacion') %>
</section>

<%- include('../partials/finLayout') %>
<%- include('../partials/footer') %>
