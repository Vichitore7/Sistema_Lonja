<%- include('../partials/head') %>
<main class="pagina-error" id="contenido">
    <div class="tarjeta">
        <div class="codigo"><%= codigo %></div>
        <h1 class="h3 mt-2"><%= titulo %></h1>
        <p class="texto-sec"><%= detalle %></p>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <% if (usuario) { %>
                <a href="/dashboard" class="btn btn-turquesa"><i class="icon-house" aria-hidden="true"></i>Ir al inicio</a>
            <% } else { %>
                <a href="/login" class="btn btn-turquesa"><i class="icon-log-in" aria-hidden="true"></i>Iniciar sesión</a>
            <% } %>
        </div>
    </div>
</main>
<%- include('../partials/footer') %>
