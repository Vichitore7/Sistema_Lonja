<%
  // Menú según rol. Especies NO aparece: se capturan dentro de "Nuevo lote".
  const esAdmin = usuario && usuario.rol === 'ADMINISTRADOR';
  const menu = [
    { clave: 'inicio', texto: 'Inicio', icono: 'house', url: '/dashboard' },
    { clave: 'inventario', texto: 'Inventario', icono: 'package', url: '/inventario' },
    { clave: 'lotes', texto: 'Lotes', icono: 'layers', url: '/lotes', admin: true },
    { clave: 'tipos', texto: 'Tipos', icono: 'tag', url: '/tipos', admin: true },
    { clave: 'compras', texto: 'Compras', icono: 'shopping-cart', url: '/compras/historial' },
    { clave: 'compradores', texto: 'Compradores', icono: 'users', url: '/compradores' },
    { clave: 'reportes', texto: 'Reportes', icono: 'chart-column', url: '/reportes' }
  ].filter((item) => !item.admin || esAdmin);
  const actual = typeof seccion !== 'undefined' ? seccion : '';
%>
<aside class="sidebar" id="sidebar" aria-label="Menú principal">
    <a href="/dashboard" class="marca">
        <img src="/img/logo.svg" alt="">
        <strong>Lonja<br>Veracruz</strong>
    </a>
    <div class="marca-sub">Sistema de gestión comercial</div>
    <div class="marca-linea"></div>
    <nav>
        <% menu.forEach((item) => { %>
            <a href="<%= item.url %>" class="nav-link <%= actual === item.clave ? 'activo' : '' %>" <%- actual === item.clave ? 'aria-current="page"' : '' %>>
                <i class="icon-<%= item.icono %>" aria-hidden="true"></i><%= item.texto %>
            </a>
        <% }) %>
        <% if (esAdmin) { %>
            <div class="separador"></div>
            <a href="/usuarios" class="nav-link <%= actual === 'usuarios' ? 'activo' : '' %>" <%- actual === 'usuarios' ? 'aria-current="page"' : '' %>>
                <i class="icon-shield-user" aria-hidden="true"></i>Usuarios
            </a>
        <% } %>
    </nav>
    <div class="ola" aria-hidden="true"></div>
</aside>
<div class="fondo-sidebar" data-cerrar-menu></div>
