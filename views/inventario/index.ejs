<%- include('../partials/head') %>
<%- include('../partials/inicioLayout') %>
<% const esAdmin = usuario.rol === 'ADMINISTRADOR'; %>

<div class="encabezado">
    <div>
        <h1>Inventario de lotes</h1>
        <p class="subtitulo">Consulta la información y el estado de los lotes de la lonja.</p>
        <div class="subrayado"></div>
    </div>
    <form class="d-flex gap-2" method="GET" action="/inventario" role="search">
        <% ['estado','especie','id_tpo','kg_min','kg_max'].forEach((c) => { if (filtros[c]) { %><input type="hidden" name="<%= c %>" value="<%= filtros[c] %>"><% } }) %>
        <div class="input-group" style="min-width:220px; max-width:360px">
            <span class="input-group-text"><i class="icon-search" aria-hidden="true"></i></span>
            <input type="search" name="buscar" class="form-control" placeholder="Buscar por lote o especie…" value="<%= filtros.buscar %>" aria-label="Buscar por lote o especie">
        </div>
        <button class="btn btn-borde-turquesa" type="submit">Buscar</button>
    </form>
</div>

<%- include('../partials/alerts') %>

<div class="row g-4">
    <div class="col-12 col-xxl-9 order-2 order-xxl-1">
        <section class="tarjeta">
            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead><tr><th>Lote</th><th>Fecha</th><th>Especies</th><th>Tipo</th><th class="num">Peso (kg)</th><th class="num">Cajas</th><th class="num">Precio de salida</th><th>Estado</th><th class="text-center">Acciones</th></tr></thead>
                    <tbody>
                    <% if (!lotes.length) { %><tr class="vacio"><td colspan="9">No hay lotes que coincidan con la búsqueda.</td></tr><% } %>
                    <% lotes.forEach((l) => { const tipos = [...new Set(l.especies.map((e) => e.tipo?.nombre))]; %>
                        <tr>
                            <td><strong><%= f.folio(l.id_lte) %></strong></td>
                            <td><%= f.formatoFecha(l.fecha) %></td>
                            <td><%= l.especies.map((e) => e.nombre).join(', ') %></td>
                            <td><%= tipos.join(', ') %></td>
                            <td class="num"><%= f.formatoNumero(l.kilos) %></td>
                            <td class="num"><%= l.numero_cajas %></td>
                            <td class="num"><%= f.formatoMoneda(l.precio_kilo_salida) %></td>
                            <td><%- include('../partials/estado', { estado: l.estado }) %></td>
                            <td>
                                <div class="acciones">
                                    <a href="/lotes/<%= l.id_lte %>?desde=inventario" class="btn-icono" title="Ver lote <%= f.folio(l.id_lte) %>" aria-label="Ver lote <%= f.folio(l.id_lte) %>"><i class="icon-search" aria-hidden="true"></i></a>
                                    <% if (esAdmin && l.estado === 'DISPONIBLE') { %>
                                        <a href="/lotes/<%= l.id_lte %>/editar" class="btn-icono" title="Editar lote" aria-label="Editar lote <%= f.folio(l.id_lte) %>"><i class="icon-pencil" aria-hidden="true"></i></a>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
            <%- include('../partials/paginacion', { nombreRegistros: 'lotes' }) %>
        </section>
    </div>

    <div class="col-12 col-xxl-3 order-1 order-xxl-2">
        <form class="tarjeta panel-filtros" method="GET" action="/inventario">
            <h2><i class="icon-filter" aria-hidden="true"></i>Filtros</h2>
            <% if (filtros.buscar) { %><input type="hidden" name="buscar" value="<%= filtros.buscar %>"><% } %>
            <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6 col-lg-3 col-xxl-12">
                <label class="form-label" for="f-estado">Estado del lote</label>
                <select id="f-estado" name="estado" class="form-select">
                    <option value="">Todos</option>
                    <% ['DISPONIBLE','VENDIDO','RETIRADO'].forEach((e) => { %><option value="<%= e %>" <%= filtros.estado === e ? 'selected' : '' %>><%= f.ETIQUETA_ESTADO[e] %></option><% }) %>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 col-xxl-12">
                <label class="form-label" for="f-especie">Especie</label>
                <select id="f-especie" name="especie" class="form-select">
                    <option value="">Todas</option>
                    <% especies.forEach((e) => { %><option value="<%= e %>" <%= filtros.especie === e ? 'selected' : '' %>><%= e %></option><% }) %>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 col-xxl-12">
                <label class="form-label" for="f-tipo">Tipo</label>
                <select id="f-tipo" name="id_tpo" class="form-select">
                    <option value="">Todos</option>
                    <% tipos.forEach((t) => { %><option value="<%= t.id_tpo %>" <%= filtros.id_tpo === String(t.id_tpo) ? 'selected' : '' %>><%= t.nombre %></option><% }) %>
                </select>
            </div>
            <fieldset class="col-12 col-sm-6 col-lg-3 col-xxl-12">
                <legend class="form-label">Rango de peso (kg)</legend>
                <div class="d-flex gap-2 align-items-center">
                    <input type="number" name="kg_min" class="form-control" placeholder="Mín." min="0" step="0.01" value="<%= filtros.kg_min %>" aria-label="Peso mínimo">
                    <span>–</span>
                    <input type="number" name="kg_max" class="form-control" placeholder="Máx." min="0" step="0.01" value="<%= filtros.kg_max %>" aria-label="Peso máximo">
                </div>
            </fieldset>
            </div>
            <div class="d-flex flex-wrap gap-2 flex-xxl-column">
                <button type="submit" class="btn btn-navy flex-fill"><i class="icon-search" aria-hidden="true"></i>Aplicar filtros</button>
                <a href="/inventario" class="btn btn-blanco flex-fill"><i class="icon-rotate-ccw" aria-hidden="true"></i>Limpiar filtros</a>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/finLayout') %>
<%- include('../partials/footer') %>
