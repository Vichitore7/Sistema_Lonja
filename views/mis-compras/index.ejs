<%- include('../partials/head') %>
<%- include('../partials/inicioLayout') %>

<%- include('../partials/encabezado', { titulo: 'Mis compras', subtitulo: 'Lotes que has comprado en la lonja. Filtra por fechas y descarga tu reporte.' }) %>
<%- include('../partials/alerts') %>

<section class="tarjeta">
    <!-- Filtro por rango de fechas (inclusive) y reporte PDF de mis compras -->
    <div class="franja"><i class="icon-calendar" aria-hidden="true"></i>Filtrar por fechas y generar reporte</div>
    <% if (errorRango) { %><div class="alert alert-danger" role="alert"><i class="icon-circle-alert" aria-hidden="true"></i><div><%= errorRango %></div></div><% } %>
    <form class="row g-2 align-items-end mb-3" method="GET" action="/mis-compras" id="formRango" novalidate>
        <div class="col-6 col-md-3">
            <label class="form-label" for="r-desde">Fecha inicial</label>
            <input type="date" id="r-desde" name="desde" class="form-control <%= errorRango ? 'is-invalid' : '' %>" value="<%= rango.desde %>" max="<%= hoy %>">
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="r-hasta">Fecha final</label>
            <input type="date" id="r-hasta" name="hasta" class="form-control <%= errorRango ? 'is-invalid' : '' %>" value="<%= rango.hasta %>" max="<%= hoy %>">
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-navy"><i class="icon-funnel" aria-hidden="true"></i>Filtrar</button></div>
        <div class="col-auto"><button type="submit" formaction="/mis-compras/pdf" class="btn btn-turquesa"><i class="icon-file-down" aria-hidden="true"></i>Exportar PDF</button></div>
        <% if (conRango || errorRango) { %><div class="col-auto"><a href="/mis-compras" class="btn btn-blanco"><i class="icon-refresh-cw" aria-hidden="true"></i>Ver todas</a></div><% } %>
        <div class="col-12"><div class="form-text">Deja las fechas vacías para ver y exportar todo tu historial. Se incluyen ambas fechas completas.</div></div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4"><div class="indicador chico"><i class="icon-shopping-bag" aria-hidden="true"></i><div><div class="etiqueta">Lotes comprados<%= conRango ? ' en el periodo' : '' %></div><div class="valor"><%= totales.compras %></div></div></div></div>
        <div class="col-6 col-md-4"><div class="indicador chico"><i class="icon-weight" aria-hidden="true"></i><div><div class="etiqueta">Kilogramos comprados</div><div class="valor"><%= f.formatoKg(totales.kilos) %></div></div></div></div>
        <div class="col-6 col-md-4"><div class="indicador chico destacado"><i class="icon-dollar-sign" aria-hidden="true"></i><div><div class="etiqueta">Total gastado</div><div class="valor"><%= f.formatoMoneda(totales.importe) %></div></div></div></div>
    </div>

    <div class="tabla-contenedor">
        <table class="tabla">
            <thead><tr><th>Folio</th><th>Fecha de compra</th><th>Lote</th><th>Especies</th><th class="num">Kilogramos</th><th class="num">Cajas</th><th class="num">Total</th><th class="text-center">Acciones</th></tr></thead>
            <tbody>
            <% if (!compras.length) { %><tr class="vacio"><td colspan="8"><% if (conRango) { %>No hiciste compras en este periodo.<% } else { %>Todavía no has comprado ningún lote. <a href="/catalogo">Ver el catálogo</a><% } %></td></tr><% } %>
            <% compras.forEach((c) => { %>
                <tr>
                    <td><strong><%= f.folio(c.id_cmp) %></strong></td>
                    <td><%= f.formatoFechaHora(c.fecha) %></td>
                    <td><span class="chip-folio"><%= f.folio(c.id_lte) %></span></td>
                    <td><%= c.lote.especies.map((es) => es.nombre).join(', ') %></td>
                    <td class="num"><%= f.formatoKg(c.lote.kilos) %></td>
                    <td class="num"><%= c.lote.numero_cajas %></td>
                    <td class="num fw-bold"><%= f.formatoMoneda(c.precio_total) %></td>
                    <td><div class="acciones"><a href="/mis-compras/<%= c.id_cmp %>" class="btn-icono" title="Ver detalle" aria-label="Ver compra <%= f.folio(c.id_cmp) %>"><i class="icon-eye" aria-hidden="true"></i></a></div></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('../partials/paginacion', { nombreRegistros: 'compras' }) %>
</section>

<%- include('../partials/finLayout') %>
<%- include('../partials/footer') %>
