<%- include('../partials/head') %>
<%- include('../partials/inicioLayout') %>

<%- include('../partials/encabezado', { titulo: 'Tipos', migas: [{ texto: 'Tipos', url: '/tipos' }, { texto: 'Listado' }] }) %>
<%- include('../partials/alerts') %>

<section class="tarjeta">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div class="tarjeta-titulo">
            <i class="icon-tag" aria-hidden="true"></i>
            <div><h2>Tipos de producto</h2><p>Consulta, registra y administra los tipos de producto.</p></div>
        </div>
        <a href="/tipos/nuevo" class="btn btn-turquesa"><i class="icon-plus" aria-hidden="true"></i>Nuevo tipo</a>
    </div>

    <form class="row g-2 align-items-end mb-3" method="GET" action="/tipos" role="search">
        <div class="col-12 col-md-5">
            <label class="form-label" for="nombre">Nombre del tipo</label>
            <div class="input-group">
                <span class="input-group-text"><i class="icon-tag" aria-hidden="true"></i></span>
                <input type="search" id="nombre" name="nombre" class="form-control" placeholder="Ej. Pescado" value="<%= nombre %>">
            </div>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-turquesa"><i class="icon-search" aria-hidden="true"></i>Buscar</button></div>
        <div class="col-auto"><a href="/tipos" class="btn btn-blanco"><i class="icon-refresh-cw" aria-hidden="true"></i>Limpiar</a></div>
    </form>

    <div class="tabla-contenedor">
        <table class="tabla">
            <thead><tr><th style="width:120px">ID</th><th>Tipo</th><th class="text-center" style="width:120px">Acciones</th></tr></thead>
            <tbody>
            <% if (!tipos.length) { %><tr class="vacio"><td colspan="3">No hay tipos registrados.</td></tr><% } %>
            <% tipos.forEach((t) => { %>
                <tr>
                    <td><%= t.id_tpo %></td>
                    <td><%= t.nombre %></td>
                    <td><div class="acciones"><a href="/tipos/<%= t.id_tpo %>/editar" class="btn-icono" title="Editar" aria-label="Editar tipo <%= t.nombre %>"><i class="icon-pencil" aria-hidden="true"></i></a></div></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('../partials/paginacion') %>
</section>

<%- include('../partials/finLayout') %>
<%- include('../partials/footer') %>
