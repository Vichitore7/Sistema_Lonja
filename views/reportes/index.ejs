<%- include('../partials/head') %>
<%- include('../partials/inicioLayout') %>

<%- include('../partials/encabezado', { titulo: 'Reportes', migas: [{ texto: 'Reportes', url: '/reportes' }, { texto: 'Reportes de compras' }] }) %>
<%- include('../partials/alerts') %>

<section class="tarjeta">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div class="tarjeta-titulo">
            <i class="icon-chart-column" aria-hidden="true"></i>
            <div><h2>Reportes de compras</h2><p>Genera el reporte de un intervalo de fechas o consulta el resumen de cada jornada.</p></div>
        </div>
    </div>

    <!-- Reporte por intervalo de fechas (inclusive). Única exportación: PDF -->
    <div class="franja"><i class="icon-file-text" aria-hidden="true"></i>Reporte por intervalo de fechas</div>
    <% if (errorRango) { %><div class="alert alert-danger" role="alert"><i class="icon-circle-alert" aria-hidden="true"></i><div><%= errorRango %></div></div><% } %>
    <form class="row g-2 align-items-end mb-4" method="GET" action="/reportes" id="formRango" novalidate>
        <div class="col-6 col-md-3">
            <label class="form-label" for="r-desde">Fecha inicial</label>
            <input type="date" id="r-desde" name="desde" class="form-control <%= errorRango ? 'is-invalid' : '' %>" value="<%= rango.desde %>" max="<%= hoy %>" required>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="r-hasta">Fecha final</label>
            <input type="date" id="r-hasta" name="hasta" class="form-control <%= errorRango ? 'is-invalid' : '' %>" value="<%= rango.hasta %>" max="<%= hoy %>" required>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-navy"><i class="icon-file-text" aria-hidden="true"></i>Ver reporte</button></div>
        <div class="col-auto"><button type="submit" formaction="/reportes/pdf" class="btn btn-turquesa"><i class="icon-file-down" aria-hidden="true"></i>Exportar PDF</button></div>
        <div class="col-12"><div class="form-text">Se incluyen las compras de ambas fechas completas (hora de Veracruz). Las ofertas publicadas que no se han comprado no cuentan.</div></div>
    </form>

    <div class="franja"><i class="icon-calendar" aria-hidden="true"></i>Jornadas con ventas</div>
    <div class="tabla-contenedor">
        <table class="tabla">
            <thead><tr><th>Fecha</th><th class="num">N.º de compras</th><th class="num">Kilogramos vendidos</th><th class="num">Importe total</th><th class="text-center">Acciones</th></tr></thead>
            <tbody>
            <% if (!jornadas.length) { %><tr class="vacio"><td colspan="5">Todavía no hay jornadas con ventas.</td></tr><% } %>
            <% jornadas.forEach((j) => { %>
                <tr>
                    <td><strong><%= f.isoATexto(j.fecha) %></strong></td>
                    <td class="num"><%= j.compras %></td>
                    <td class="num"><%= f.formatoKg(j.kilos) %></td>
                    <td class="num fw-bold"><%= f.formatoMoneda(j.importe) %></td>
                    <td>
                        <div class="acciones">
                            <a href="/reportes?desde=<%= j.fecha %>&hasta=<%= j.fecha %>" class="btn-icono" title="Ver reporte" aria-label="Ver reporte del <%= f.isoATexto(j.fecha) %>"><i class="icon-eye" aria-hidden="true"></i></a>
                            <a href="/reportes/pdf?desde=<%= j.fecha %>&hasta=<%= j.fecha %>" class="btn-icono" title="Exportar PDF" aria-label="Exportar PDF del <%= f.isoATexto(j.fecha) %>"><i class="icon-file-down" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('../partials/paginacion') %>
</section>

<%- include('../partials/finLayout') %>
<%- include('../partials/footer') %>
